/ {
	chosen {
		zephyr,dgus = &dwin_screen;
	};

	dwin_screen: dgus2 {
		compatible = "dwin,dgus2";
		uart = <&usart3>;
		status = "okay";
		current-speed = <115200>;
	};
};

&usart3 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&usart3_tx_pd8 &usart3_rx_pd9>;
	pinctrl-names = "default";
};
